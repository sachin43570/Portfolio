# Copy this file to .env and fill in your real values. Never commit .env itself.

# The Gmail address that will SEND the email (can be the same as your receiving address)
EMAIL_USER=your-gmail-address@gmail.com

# A Gmail "App Password" — NOT your normal Gmail password.
# See backend/README.md for how to generate one.
EMAIL_PASS=your-16-character-app-password

# The address that receives contact form messages
RECEIVING_EMAIL=sachinmaurya43570@gmail.com

PORT=5000
